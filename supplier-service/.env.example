# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env

# Postgres
POSTGRES_USER=supplier_service
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=supplier_service

# Подпись сессий/cookie — сгенерируйте случайную строку, например:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_random_secret

# Первый (админский) пользователь, создаётся автоматически при первом запуске
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
